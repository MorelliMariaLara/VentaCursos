{
  "folders": [
    {
      "name": "NEXA Web — Venta de cursos",
      "path": "."
    }
  ],
  "settings": {
    "npm.packageManager": "npm"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "NEXA Web (proyecto de inicio)",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run solution:start",
        "cwd": "${workspaceFolder}"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss"
    ]
  }
}
