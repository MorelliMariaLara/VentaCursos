@model List<MyCourseItemViewModel>
@{
    ViewData["Title"] = "Mis cursos";
}
<section class="section">
    <div class="wrap">
        <h2>Mis cursos</h2>
        <p class="lead">Tu biblioteca de programas comprados.</p>
        <div class="course-list">
            @if (Model.Count == 0)
            {
                <p class="hint">Todavía no compraste. <a asp-controller="Courses" asp-action="Index">Ver catálogo</a></p>
            }
            else
            {
                foreach (var item in Model)
                {
                    var c = item.Course;
                    <a class="course-row" asp-controller="Learn" asp-action="Index" asp-route-slug="@c.Slug">
                        <span class="bar" style="background:@c.ThumbnailGradient"></span>
                        <div>
                            <h3>@c.Title</h3>
                            <p>@c.Subtitle</p>
                            <div class="meta">@(string.IsNullOrEmpty(item.Enrollment.CertificateCode) ? "En progreso" : "Certificado listo")</div>
                        </div>
                        <div class="price">Abrir</div>
                    </a>
                }
            }
        </div>
    </div>
</section>
