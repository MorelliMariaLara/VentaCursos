@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}
<section class="section">
    <div class="wrap grid-2">
        <div>
            <h2>@Model.Course.Title</h2>
            <p class="lead">Pago seguro con Mercado Pago (Checkout Pro · QR / tarjeta)</p>
            <p class="price" style="font-size:1.4rem">@Model.PriceLabel</p>
            <p class="hint">El aula y los videos se habilitan <strong>solo cuando el pago esté acreditado</strong>.</p>
            @if (!string.IsNullOrEmpty(Model.Status))
            {
                <p class="hint" id="statusHint">Estado: @Model.Status</p>
            }
        </div>
        <div class="panel">
            <div id="walletBrick_container"></div>
            <div id="pendingBox" style="display:none;margin-top:1rem">
                <p class="ok" id="pendingMsg">Esperando acreditación del pago…</p>
                <p class="hint">Pagá en la ventana de Mercado Pago (QR o tarjeta). Después volvé acá y esperá, o tocá “Verificar pago”.</p>
                <div class="cta-row" style="margin-top:0.8rem">
                    <button class="btn btn-primary" id="refreshStatusBtn" type="button">Verificar pago</button>
                </div>
            </div>
            <button class="btn btn-accent" id="simulateBtn" type="button" style="display:none;width:100%;margin-top:0.8rem">
                Simular pago (solo demo local)
            </button>
            <p class="error" id="err"></p>
            <p class="hint" id="cfgHint" style="margin-top:0.8rem"></p>
        </div>
    </div>
</section>
@section Scripts {
<script>
  const slug = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Course.Slug));
  const initialStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Status ?? ""));
  const urlOrderId = new URLSearchParams(location.search).get("orderId");

  let orderId = urlOrderId;
  let pollTimer = null;

  function showPending(msg) {
    document.getElementById("pendingBox").style.display = "block";
    if (msg) document.getElementById("pendingMsg").textContent = msg;
  }

  async function checkOrder() {
    if (!orderId) return null;
    const data = await api("/api/payments/order/" + encodeURIComponent(orderId));
    if (data.accredited && data.redirect) {
      stopPoll();
      document.getElementById("pendingMsg").textContent = "¡Pago acreditado! Abriendo el aula…";
      location.href = data.redirect;
      return data;
    }
    return data;
  }

  function startPoll() {
    stopPoll();
    pollTimer = setInterval(() => { checkOrder().catch(() => {}); }, 4000);
  }

  function stopPoll() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  document.getElementById("refreshStatusBtn").onclick = () => {
    checkOrder().catch((e) => { document.getElementById("err").textContent = e.message; });
  };

  function showApiError(e) {
    const msg = e?.message || "Error";
    const diag = e?.data?.diagnostics;
    document.getElementById("err").textContent = msg;
    if (diag) {
      document.getElementById("cfgHint").textContent = "Credenciales cargadas: " + diag;
    }
  }

  async function mountWallet(cfg, pref) {
    const hint = document.getElementById("cfgHint");
    hint.textContent = cfg.testCredentials
      ? "Modo prueba (TEST). Pagá con el botón de Mercado Pago y un usuario de prueba."
      : "Pagá con Mercado Pago. Luego volvé a esta pestaña para desbloquear el curso.";

    try {
      await new Promise((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "https://sdk.mercadopago.com/js/v2";
        s.onload = resolve;
        s.onerror = () => reject(new Error("No se pudo cargar el SDK de Mercado Pago"));
        document.body.appendChild(s);
      });

      const mp = new MercadoPago(cfg.publicKey, { locale: "es-AR" });
      await mp.bricks().create("wallet", "walletBrick_container", {
        initialization: {
          preferenceId: pref.preferenceId,
          redirectMode: "blank",
        },
        customization: {
          texts: { valueProp: "smart_option" },
        },
        callbacks: {
          onReady: () => {
            showPending("Cuando termines de pagar, el curso se habilita acá automáticamente.");
            startPoll();
          },
          onSubmit: () => {
            showPending("Pago iniciado. Esperando acreditación…");
            startPoll();
            return Promise.resolve();
          },
          onError: (err) => {
            console.error(err);
            document.getElementById("err").textContent =
              err?.message || "No se pudo cargar el botón de Mercado Pago. Recargá la página.";
          },
        },
      });
    } catch (e) {
      console.error(e);
      document.getElementById("err").textContent = e.message || "Error al iniciar Mercado Pago";
    }
  }

  (async () => {
    const cfg = await api("/api/payments/config");
    const hint = document.getElementById("cfgHint");
    if (cfg.diagnostics) hint.textContent = cfg.diagnostics;

    if (cfg.problem) {
      document.getElementById("err").textContent = cfg.problem;
      if (cfg.diagnostics) hint.textContent = cfg.diagnostics;
      return;
    }
    if (cfg.configured && cfg.pairOk === false) {
      document.getElementById("err").textContent =
        "MP_PUBLIC_KEY y MP_ACCESS_TOKEN no son del mismo tipo (uno es TEST- y el otro APP_USR-). Pegá el par de Pruebas en .env y reiniciá.";
      return;
    }

    const returning =
      !!orderId &&
      ["pending", "in_process", "success", "approved", "failure", "rejected"].includes(initialStatus);

    if (returning) {
      showPending("Confirmando el estado de tu pago…");
      startPoll();
      const data = await checkOrder();
      if (data && data.accredited) return;

      const failedStatuses = ["failure", "rejected", "cancelled", "failed", "refunded"];
      const failed =
        failedStatuses.includes(initialStatus) ||
        (data && failedStatuses.includes(data.status));

      if (!failed) {
        hint.textContent = "Si ya pagaste, tocá «Verificar pago». Seguimos consultando a Mercado Pago…";
        return;
      }
      hint.textContent = "El pago anterior falló. Generamos un nuevo checkout abajo.";
    }

    let pref;
    try {
      pref = await api("/api/payments/preference", {
        method: "POST",
        body: JSON.stringify({ slug }),
      });
    } catch (e) {
      showApiError(e);
      return;
    }
    orderId = pref.orderId || orderId;

    const canUseMp = cfg.configured && cfg.publicKey && pref.preferenceId && !pref.simulateOnly;
    if (canUseMp) {
      await mountWallet(cfg, pref);
      return;
    }

    const simBtn = document.getElementById("simulateBtn");
    if (cfg.simulate || pref.simulateOnly) {
      simBtn.style.display = "inline-flex";
      hint.textContent = "Mercado Pago no está configurado: podés simular el pago en local.";
      if (cfg.diagnostics) hint.textContent += " · " + cfg.diagnostics;
      simBtn.onclick = async () => {
        try {
          const result = await api("/api/payments/process", {
            method: "POST",
            body: JSON.stringify({ orderId, simulate: true }),
          });
          location.href = result.redirect;
        } catch (e) {
          document.getElementById("err").textContent = e.message;
        }
      };
      return;
    }

    document.getElementById("err").textContent =
      cfg.problem ||
      "Configurá MP_PUBLIC_KEY y MP_ACCESS_TOKEN en .env (mismo par de Pruebas) y reiniciá.";
  })().catch((e) => {
    showApiError(e);
  });

  window.addEventListener("beforeunload", stopPoll);
  window.addEventListener("focus", () => { checkOrder().catch(() => {}); });
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") checkOrder().catch(() => {});
  });
</script>
}
