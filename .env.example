AUTH_SECRET=cambia-este-secreto-de-sesion
STREAM_SECRET=cambia-este-secreto-de-stream

# URL pública de la app (back_urls / webhooks)
APP_URL=http://localhost:3000

# Mercado Pago Checkout Bricks
# Credenciales de prueba o producción desde https://www.mercadopago.com.ar/developers/panel
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxx

# Webhook público (opcional en local; usar ngrok/cloudflare tunnel)
# MP_WEBHOOK_URL=https://tu-dominio.com/api/webhooks/mercadopago

# true = permite simular pagos si no hay credenciales (solo desarrollo)
MP_ALLOW_SIMULATE=true
