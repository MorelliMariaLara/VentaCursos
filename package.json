{
  "name": "nexa-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/check-next.mjs",
    "dev": "node ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start --port 3000",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "solution:setup": "node scripts/setup.mjs",
    "solution:start": "node ./node_modules/next/dist/bin/next dev --port 3000",
    "solution:up": "docker compose up --build -d",
    "solution:down": "docker compose down",
    "solution:logs": "docker compose logs -f nexa",
    "inicio": "node scripts/setup.mjs && node ./node_modules/next/dist/bin/next dev --port 3000",
    "reparar": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "mercadopago": "^3.2.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  },
  "description": "NEXA Web — proyecto de inicio: venta de cursos, Mercado Pago y aula cifrada"
}
